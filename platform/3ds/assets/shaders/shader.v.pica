; aaaaaaa

; Uniforms
.fvec ModelMatrix[4], ViewMatrix[4], ProjectionMatrix[4], NormalQuat

; Constants
.constf myconst(0.0, 1.0, -1.0, 0.5)
.alias  zeros myconst.xxxx ; Vector full of zeros
.alias  ones  myconst.yyyy ; Vector full of ones
.alias  half  myconst.wwww


; Inputs (defined as aliases for convenience)
.alias VertexPosition v0
.alias VertexNormal v1
.alias TexCoord v2
.alias VertexColor v3

; Outputs
.out outpos position
;.out outtc0 texcoord0
.out outclr color
;.out outview view
;.out outnq normalquat

.proc main
	; Force the w component of VertexPosition to be 1.0
	mov r0.xyz, VertexPosition.xyz
	mov r0.w,   myconst.y

	; outpos = ModelMatrix * VertexPosition
	dp4 r1.x, ModelMatrix[0], r0
	dp4 r1.y, ModelMatrix[1], r0
	dp4 r1.z, ModelMatrix[2], r0
	dp4 r1.w, ModelMatrix[3], r0

	; outpos = ViewMatrix * VertexPosition
	dp4 r2.x, ViewMatrix[0], r1
	dp4 r2.y, ViewMatrix[1], r1
	dp4 r2.z, ViewMatrix[2], r1
	dp4 r2.w, ViewMatrix[3], r1

	; outpos = projectionMatrix * VertexPosition
	dp4 outpos.x, ProjectionMatrix[0], r2
	dp4 outpos.y, ProjectionMatrix[1], r2
	dp4 outpos.z, ProjectionMatrix[2], r2
	dp4 outpos.w, ProjectionMatrix[3], r2

	; outclr = inclr
	mov outclr, VertexColor

	; mov outnq, ones

	; We're finished
	end
.end